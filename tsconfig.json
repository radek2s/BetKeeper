{
  "compilerOptions": {
    "target": "esnext",
    "baseUrl": "./",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@domain/*": ["domain/src/*"],
      "@bet-keeper/domain/test/*": ["domain/tests/*"],
      "@app/*": ["application/src/*"],
      "@app-test/*": ["application/test/*"],
      "@db/*": ["application/generated/prisma"],
      "@test/*": ["./test/*"],
      "@e2e-tests/*": ["./e2e-tests/*"],
      "@database/*": ["database/*"]
    },
    "moduleResolution": "node",
    "resolveJsonModule": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
