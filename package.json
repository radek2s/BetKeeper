{
  "name": "bet-keeper",
  "version": "3.0.0-alpha.3",
  "private": true,
  "homepage": "https://radek2s.github.io/BetKeeper",
  "scripts": {
    "dev": "nx run application:dev",
    "dev:db:reset": "dotenv -e .env.dev -- npx prisma migrate reset --force",
    "dev:db:migrate": "dotenv -e .env.dev -- npx prisma migrate dev --name=init",
    "dev:db:generate": "dotenv -e .env.dev -- npx prisma generate",
    "dev:db:populate": "dotenv -e .env.dev -- node ./schema_e2e.seed.js",
    "dev:init": "npm run dev:db:reset && npm run dev:db:migrate && npm run dev:db:generate && npm run dev:db:populate",
    "test:bdd": "npx cucumber-js e2e-tests",
    "test": "vitest",
    "test:domain:ci": "npx nx run test domain --reporter junit --output-file ./tests-domain.xml",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage --reporter junit --output-file ./test-report.xml",
    "test:coverage:report": "vitest run --coverage",
    "build": "npx nx run application:build",
    "build:prod": "npm run prod:generate && npx nx run application:build",
    "prod:generate": "npx prisma generate",
    "preview": "npx nx run application:start",
    "build:ci": "CI=false && tsc && vite build",
    "e2e": "nx run e2e-tests:e2e",
    "e2e:ui": "nx run e2e-tests:ui",
    "e2e:db:reset": "dotenv -e .env.e2e -- npx prisma migrate reset --force",
    "e2e:db:migrate": "dotenv -e .env.e2e -- npx prisma migrate dev --name=init",
    "e2e:db:generate": "dotenv -e .env.e2e -- npx prisma generate",
    "e2e:db:populate": "dotenv -e .env.e2e -- node ./schema_e2e.seed.js",
    "prepare-e2e": "npm run e2e:db:reset && npm run e2e:db:migrate && npm run e2e:db:generate && npm run e2e:db:populate"
  },
  "dependencies": {
    "@corbado/node-sdk": "^3.0.5",
    "@corbado/react": "^3.5.0",
    "@prisma/client": "~6.0.0",
    "@tanstack/react-query": "^5.90.16",
    "axios": "1.13.1",
    "clsx": "^2.1.1",
    "firebase": "^11.5.0",
    "nanoid": "5.1.6",
    "next": "16.1.6",
    "pino": "^10.1.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tslib": "2.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@corbado/types": "^3.1.0",
    "@cucumber/cucumber": "^11.3.0",
    "@nx/playwright": "^22.0.2",
    "@nx/devkit": "22.0.2",
    "@nx/jest": "22.0.2",
    "@nx/js": "22.0.2",
    "@nx/next": "22.0.2",
    "@nx/vite": "22.0.2",
    "@nx/web": "22.0.2",
    "@tailwindcss/postcss": "4.1.16",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "ajv": "^8.0.0",
    "autoprefixer": "10.4.13",
    "babel-jest": "^29.7.0",
    "baseline-browser-mapping": "^2.9.11",
    "@playwright/test": "^1.40.0",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.0.2",
    "pino-pretty": "^13.1.2",
    "postcss": "8.5.6",
    "prettier": "^2.6.2",
    "prisma": "~6.0.0",
    "tailwindcss": "4.1.16",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.1",
    "typescript": "~5.1.0",
    "vite": "7.1.12",
    "vite-plugin-dts": "4.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "nx": {}
}
