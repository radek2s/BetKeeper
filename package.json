{
  "name": "bet-keeper",
  "version": "3.0.0-alpha.3",
  "private": true,
  "homepage": "https://radek2s.github.io/BetKeeper",
  "scripts": {
    "dev": "dotenv -e .env.local -e .env.base -- nx run application:dev",
    "dev:db:reset": "dotenv -e .env.local -e .env.base -- prisma migrate reset --force",
    "dev:db:migrate": "dotenv -e .env.local -e .env.base -- prisma migrate dev --name=init",
    "dev:db:generate": "dotenv -e .env.local -e .env.base -- prisma generate",
    "dev:db:populate": "dotenv -e .env.local -e .env.base -- tsx ./database/init/schema_e2e.seed.ts",
    "dev:init": "npm run dev:db:reset && npm run dev:db:migrate && npm run dev:db:generate && npm run dev:db:populate",
    "test": "vitest",
    "test:domain:ci": "npx nx run test domain --reporter junit --output-file ./tests-domain.xml",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage --reporter junit --output-file ./test-report.xml",
    "test:coverage:report": "vitest run --coverage",
    "build": "nx run application:build",
    "build:prod": "npm run prod:generate && npx nx run application:build",
    "prod:generate": "prisma generate",
    "prod:studio": "dotenv -e .env.local -e .env.base -- prisma studio",
    "prod:migrate:sync": "dotenv -e .env.local -e .env.base -- prisma db push",
    "prod:migrate:dev": "dotenv -e .env.local -e .env.base -- prisma migrate dev --name=second",
    "preview": "nx run application:start",
    "build:ci": "CI=false && tsc && vite build",
    "e2e": "nx run e2e-tests:e2e",
    "e2e:ui": "nx run e2e-tests:ui",
    "e2e:ci": "npm run prepare-e2e && npm run e2e",
    "e2e:dev": "dotenv -e .env.test.local -e .env.test -- nx run application:dev",
    "e2e:db:reset": "dotenv -e .env.test.local -e .env.test -- prisma migrate reset --force",
    "e2e:db:migrate": "dotenv -e .env.test.local -e .env.test -- prisma migrate dev --name=init",
    "e2e:db:generate": "dotenv -e .env.test.local -e .env.test -- prisma generate",
    "e2e:db:populate": "dotenv -e .env.test.local -e .env.test -- tsx ./database/init/schema_e2e.seed.ts",
    "e2e:init": "npm run e2e:db:reset && npm run e2e:db:migrate && npm run e2e:db:generate && npm run e2e:db:populate",
    "prepare-e2e": "npm run e2e:db:reset && npm run e2e:db:migrate && npm run e2e:db:generate && npm run e2e:db:populate",
    "openapi:generate": "next-openapi-gen generate"
  },
  "dependencies": {
    "@corbado/node-sdk": "^3.0.5",
    "@corbado/react": "^3.6.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "~7.10.0",
    "@scalar/api-reference-react": "^0.9.66",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "mailtrap": "^4.10.0",
    "nanoid": "5.1.6",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tslib": "2.8.1",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@corbado/types": "^3.2.0",
    "@cucumber/cucumber": "^12.6.0",
    "@microsoft/api-extractor": "^7.58.2",
    "@nx/devkit": "23.2.0",
    "@nx/jest": "^23.2.0",
    "@nx/js": "^23.2.0",
    "@nx/next": "^23.2.0",
    "@nx/playwright": "^23.2.0",
    "@nx/vite": "^23.2.0",
    "@nx/web": "^23.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "ajv": "^8.18.0",
    "autoprefixer": "10.4.24",
    "babel-jest": "^30.5.1",
    "baseline-browser-mapping": "^2.9.19",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jiti": "2.7.0",
    "jsdom": "~30.0.1",
    "jsonc-eslint-parser": "^2.4.2",
    "next-openapi-gen": "^1.8.1",
    "nx": "23.2.0",
    "pino-pretty": "^13.1.3",
    "postcss": "8.5.26",
    "prettier": "^3.8.1",
    "prisma": "^7.7.0",
    "tailwindcss": "4.2.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "4.23.13",
    "typescript": "~5.4.0",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "nx": {}
}
