datasource db {
    provider    = "sqlite"
    url         = "file:./betKeeperE2E.db"
}

generator client {
    provider    = "prisma-client-js"
    output = "./application/generated/prisma"
}

model UserTable {
    id          String @id @default(uuid())
    email       String @unique
    firstName   String
    lastName    String
    status      String
    avatarUrl   String?
    role        String?

    @@map("user")
}

model UserRequestTable {
    id              String @id @default(uuid())
    requesterId     String 
    inviteeEmail    String
    status          String
    createdAt       DateTime 
    approvedById    String? 
    approvedAt      DateTime? 

    @@map("user_request")
}

model FriendRequestTable {
    id              String @id @default(uuid())
    senderId        String 
    reciverId       String 
    status          String
    createdAt       DateTime 
    expiresAt       DateTime? 

    @@map("friend_request")
}

model BetTable {
    id                  String @id @default(uuid())
    creatorId           String 
    participantId       String 
    terms               String
    status              String
    createdAt           DateTime 
    updatedAt           DateTime 
    dueDate             DateTime? 
    resolvedAt          DateTime? 
    completedAt         DateTime? 
    winnerId            String? 
    evidence            String?
    completionNotes     String?

    @@map("bet")
}

model BetRequestTable {
    id                  String @id @default(uuid())
    creatorId           String 
    participantId       String 
    terms               String
    status              String
    createdAt           DateTime 
    updatedAt           DateTime 

    @@map("bet_request")
}