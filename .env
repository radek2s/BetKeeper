######################################   General variables   #########################################
NEXT_PUBLIC_APP_VERSION="3.0.0-beta.1"
# PROJECT_DIR="/home/betkeeper/"                                # Absolute path to root directory of this project

######################################   Database configuration   ##############################################################
DATABASE_URL="file:./database/data/betKeeper.db"                                # generated SQLite file location / or Postgres Direct URL connection string
# DATABASE_URL_PG="postgresql://betkeeper:betkeeper@localhost:5432/betkeeper"   # PostgreSQL connection string (required for Supabase)
DATABASE_SCHEMA="schema_sqlite"                                                 # prisma adapter configuration


######################################   Application run mode   #####################################################################
NEXT_PUBLIC_AUTH_MODE="MANUAL"                                  # Disable this to run 'CORBADO' authentication mode
NEXT_PUBLIC_USER_ID="00000000-0000-0000-0000-000011110000"      # Default userId generated via seed scrpt


######################################   Corbado authentication  ################################################################
# NEXT_PUBLIC_CORBADO_PROJECT_ID=pro-0000000000000000000
# CORBADO_API_SECRET=corbado1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CORBADO_FRONTEND_API=https://pro-0000000000000000000...
# CORBADO_BACKEND_API=.https://..


######################################   Mailing Service   #####################################################################
# EMAIL_PROVIDER="MAILTRAP"                                     # Uncomment to enable Mailtrap itegration ['MAILTRAP' | empty]
# EMAIL_ADMIN="administrator@test.com"                          # Provide application administrator account who will receive system emails
# EMAIL_MAILTRAP_API_KEY="API_KEY"                              # APIKEY for Mailtrap account to integrate SDK