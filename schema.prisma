datasource db {
    url         = "postgresql://betkeeper:betkeeper@localhost:5432/betkeeper?schema=betkeeper"
    provider    = "postgresql"
}

generator client {
    provider    = "prisma-client-js"
    output = "./application/generated/prisma"
}

model UserTable {
    id          String @id @default(uuid())
    email       String @unique
    firstName   String
    lastName    String
    status      String

    @@map("user")
}

model UserRequestTable {
    id              String @id @default(uuid())
    requesterId     String @db.Uuid
    inviteeEmail    String
    status          String
    createdAt       DateTime @db.Timestamp(3)
    approvedById    String? @db.Uuid
    approvedAt      DateTime? @db.Timestamp(3)

    @@map("user_request")
}

model FriendRequestTable {
    id              String @id @default(uuid())
    senderId        String @db.Uuid
    reciverId       String @db.Uuid
    status          String
    createdAt       DateTime @db.Timestamp(3)
    expiresAt       DateTime? @db.Timestamp(3)

    @@map("friend_request")
}

model BetTable {
    id                  String @id @default(uuid())
    creatorId           String @db.Uuid
    participantId       String @db.Uuid
    terms               String
    status              String
    createdAt           DateTime @db.Timestamp(3)
    updatedAt           DateTime @db.Timestamp(3)
    dueDate             DateTime? @db.Timestamp(3)
    resolvedAt          DateTime? @db.Timestamp(3)
    completedAt         DateTime? @db.Timestamp(3)
    winnerId            String? @db.Uuid
    evidence            String?
    completionNotes     String?

    @@map("bet")
}

model BetRequestTable {
    id                  String @id @default(uuid())
    creatorId           String @db.Uuid
    participantId       String @db.Uuid
    terms               String
    status              String
    createdAt           DateTime @db.Timestamp(3)
    updatedAt           DateTime @db.Timestamp(3)

    @@map("bet_request")
}