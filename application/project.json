{
  "name": "application",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "tags": ["score:application", "type:nextjs"],
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "options": {
        "outputPath": "dist/application",
        "webpack": true
      }
    },
    "preview": {
      "executor": "@nx/next:preview"
    },
    "serve": {
      "executor": "@nx/next:server",
      "options": {
        "buildTarget": "application:build"
      }
    },
    "test:unit": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "{projectRoot}/vitest.config.ts"
      }
    },
    "test:integration": {
      "executor": "@nx/vitest:test",
      "dependsOn": ["prisma-reset"],
      "options": {
        "configFile": "{projectRoot}/vitest.config.integaration.ts"
      }
    },
    "prisma-reset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx prisma migrate reset --force --schema ./schema_sqlite.prisma"
      }
    }
  }
}
